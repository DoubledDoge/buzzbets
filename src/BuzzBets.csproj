<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Label="General Configuration">
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>AnyCpu</PlatformTarget>
		<OutputType>Exe</OutputType>
		<ApplicationIcon>../icon.ico</ApplicationIcon>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Optimize>true</Optimize>
		<Deterministic>true</Deterministic>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>All</AnalysisMode>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup Label="GlobalUsings">
		<Using Include="System.Globalization" />
		<Using Include="System.Text" />
		<Using Include="System.Text.Json" />
	</ItemGroup>

	<ItemGroup Label="Icon">
		<None Include="../icon.ico" Pack="true" PackagePath="/" />
	</ItemGroup>

	<ItemGroup Label="JSON Data">
		<Content Include="data\drones.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup Label="External Packages">
		<PackageReference Include="ConsolePrism" Version="1.3.1" />
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.25.0.139117">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="TypeGuard.Console" Version="1.2.0" />
	</ItemGroup>
</Project>
